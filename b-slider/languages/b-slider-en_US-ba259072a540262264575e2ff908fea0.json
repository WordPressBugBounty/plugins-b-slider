{"translation-revision-date":"YEAR-MO-DA HO:MI+ZONE","generator":"WP-CLI\/2.12.0","source":"build\/admin-dashboard.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"en","plural-forms":"nplurals=2; plural=(n != 1);"},"Edit":[""],"The saved channels could not be loaded.":[""],"That channel could not be saved.":[""],"That channel could not be removed.":[""],"Connection expired \u2014 paste a new access token to reconnect.":[""],"Instagram is refusing this token. Paste a new one to reconnect.":[""],"Renews within %d day.":[""],"Connected \u00b7 renews in %d day.":[""],"Connected \u00b7 renewal is checked within a day.":[""],"YouTube Channel":[""],"RSS Feed":[""],"JSON Feed":[""],"Instagram Feed":[""],"Add a feed":[""],"Add JSON feed":[""],"Add Instagram Account":[""],"Add a channel":[""],"Edit feed":[""],"Edit JSON feed":[""],"Edit Instagram Account":[""],"Edit channel":[""],"Feed Type":[""],"Name":[""],"e.g. Our blog feed":[""],"e.g. Our API feed":[""],"e.g. @username":[""],"e.g. Our tutorials":[""],"Only for you \u2014 this is what the pickers show.":[""],"Instagram Access Token":[""],"Feed URL":[""],"Channel address":[""],"Leave blank to keep the saved token":[""],"Paste Instagram Access Token here":[""],"A token ending %s is saved. Type a new one only to replace it.":[""],"An access token from the Instagram API with Instagram Login.":[""],"A valid RSS, Atom or JSON feed URL.":[""],"A channel URL, its @handle, its UC\u2026 ID, or a playlist URL.":[""],"YouTube Refresh Token (Optional for Private Videos)":[""],"Enter Refresh Token":[""],"Required only if you wish to display private or unlisted videos in the slider.":[""],"Slides List Key":[""],"Path to list array inside JSON response (e.g. \"data.posts\"). Leave empty if root is array.":[""],"Slide Title Key":[""],"Field name for slide title text.":[""],"Description \/ Excerpt Key":[""],"Field name for slide description caption text.":[""],"Button Label Key":[""],"Field name for custom